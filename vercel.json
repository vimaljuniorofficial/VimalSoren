{
  "framework": null,
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/:path((?!.*\\.).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/gltf/(.*)",
      "headers": [{ "key": "Content-Type", "value": "model/gltf-binary" }]
    }
  ]
}
